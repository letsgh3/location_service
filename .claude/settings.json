{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-tests.sh\"",
            "timeout": 180,
            "statusMessage": "Przed commitem: pytest -q..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-commit-tests.sh\"",
            "timeout": 180,
            "statusMessage": "Po commicie: pytest -q..."
          }
        ]
      }
    ]
  }
}
